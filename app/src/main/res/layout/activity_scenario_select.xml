<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6F0">

    <!-- 상단 배너 광고 -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-1872760638277957/4823332638" />

    <!-- 메인 콘텐츠 레이아웃 -->
    <LinearLayout
        android:id="@+id/scenarioContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/adView"
        android:layout_above="@id/button_share"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <!-- 카테고리 선택 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- 카테고리 영역 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="학습 난이도"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/dohyeon_regular"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/categorySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown"
                    android:background="@drawable/bg_spinner_cute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:fontFamily="@font/dohyeon_regular" />
            </LinearLayout>

            <View android:layout_width="12dp" android:layout_height="0dp" />

            <!-- 문장 순서 영역 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시나리오 문장 재생 방식"
                    android:textSize="16sp"
                    android:textColor="#000000"
                    android:fontFamily="@font/dohyeon_regular"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/orderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:spinnerMode="dropdown"
                    android:background="@drawable/bg_spinner_cute"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:fontFamily="@font/dohyeon_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- 시나리오 카드 리스트 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_cute"
            android:padding="8dp"
            android:elevation="2dp"
            android:layout_marginBottom="8dp">

            <ListView
                android:id="@+id/listViewScenarios"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#FFE0E0"
                android:dividerHeight="1dp"
                android:background="#FFFFFF"
                android:padding="6dp"
                android:fontFamily="@font/nanum_pen" />
        </LinearLayout>
    </LinearLayout>

    <!-- 친구에게 추천하기 버튼 -->
    <Button
        android:id="@+id/button_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="❤️ 친구에게 영받쓰AI 추천하기"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/dohyeon_regular"
        android:backgroundTint="#FF8A65"
        android:elevation="4dp" />

    <!-- 하단 네비게이션 -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/selector_nav_icon"
        app:itemTextColor="@color/selector_nav_text"
        app:labelVisibilityMode="labeled" />
</RelativeLayout>
